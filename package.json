{
  "name": "proof-of-forest",
  "version": "1.0.0",
  "description": "Satellite-verified, oracle-signed reforestation carbon credits (Sentinel-2 NDVI + ERC-1155)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:engine": "cd engine && python -m pytest -q",
    "coverage": "hardhat coverage",
    "verify:all": "node scripts/verify-all.js",
    "sync": "node scripts/sync-frontend.js",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost && node scripts/sync-frontend.js",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy && node scripts/sync-frontend.js",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia && node scripts/sync-frontend.js",
    "frontend": "cd frontend && npm run dev",
    "build:frontend": "node scripts/sync-frontend.js && cd frontend && npm run build",
    "demo": "node scripts/demo.js",
    "postinstall": "cd frontend && npm install"
  },
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^4.5.0",
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solc": "^0.8.24",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3"
  }
}
